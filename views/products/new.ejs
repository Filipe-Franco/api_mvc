<%- include('../partials/header', { user: user }) %>

<h2>Cadastrar Produto</h2>

<form action="/products" method="POST" enctype="multipart/form-data">
    <div class="mb-3">
        <label for="name" class="form-label">Nome *</label>
        <input type="text" class="form-control <%= errors && errors.some(e => e.path === 'name') ? 'is-invalid' : '' %>" 
               id="name" name="name" value="<%= oldInput ? oldInput.name : (product ? product.name : '') %>">
        <% if (errors) { 
            const nameError = errors.find(e => e.path === 'name');
            if (nameError) { %>
                <div class="invalid-feedback"><%= nameError.msg %></div>
        <% } } %>
    </div>

    <div class="mb-3">
        <label for="price" class="form-label">Preço (R$) *</label>
        <input type="number" step="0.01" class="form-control <%= errors && errors.some(e => e.path === 'price') ? 'is-invalid' : '' %>" 
               id="price" name="price" value="<%= oldInput ? oldInput.price : (product ? product.price : '') %>">
        <% if (errors) { 
            const priceError = errors.find(e => e.path === 'price');
            if (priceError) { %>
                <div class="invalid-feedback"><%= priceError.msg %></div>
        <% } } %>
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Descrição</label>
        <textarea class="form-control" id="description" name="description" rows="3"><%= oldInput ? oldInput.description : (product ? product.description : '') %></textarea>
    </div>

    <div class="mb-3">
        <label for="image" class="form-label">Imagem do Produto (opcional, max 2MB, JPG/PNG/GIF)</label>
        <input type="file" class="form-control" id="image" name="image" accept="image/*">
        <% if (errors && errors.some(e => e.msg.includes('imagem'))) { %>
            <div class="text-danger small">Formato inválido ou arquivo muito grande.</div>
        <% } %>
    </div>

    <button type="submit" class="btn btn-primary">Salvar</button>
    <a href="/products" class="btn btn-secondary">Cancelar</a>
</form>

<%- include('../partials/footer') %>