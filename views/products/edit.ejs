<%- include('../partials/header', { user: user }) %>

<h2>Editar Produto</h2>

<form action="/products/<%= product.id %>?_method=PUT" method="POST" enctype="multipart/form-data">
    <div class="mb-3">
        <label for="name" class="form-label">Nome *</label>
        <input type="text" class="form-control <%= errors && errors.some(e => e.path === 'name') ? 'is-invalid' : '' %>" 
               id="name" name="name" value="<%= oldInput ? oldInput.name : product.name %>">
        <% if (errors) { 
            const nameError = errors.find(e => e.path === 'name');
            if (nameError) { %>
                <div class="invalid-feedback"><%= nameError.msg %></div>
        <% } } %>
    </div>

    <div class="mb-3">
        <label for="price" class="form-label">Preço (R$) *</label>
        <input type="number" step="0.01" class="form-control <%= errors && errors.some(e => e.path === 'price') ? 'is-invalid' : '' %>" 
               id="price" name="price" value="<%= oldInput ? oldInput.price : product.price %>">
        <% if (errors) { 
            const priceError = errors.find(e => e.path === 'price');
            if (priceError) { %>
                <div class="invalid-feedback"><%= priceError.msg %></div>
        <% } } %>
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Descrição</label>
        <textarea class="form-control" id="description" name="description" rows="3"><%= oldInput ? oldInput.description : (product.description || '') %></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Imagem atual</label><br>
        <% if (product.imageUrl) { %>
            <img src="<%= product.imageUrl %>" style="max-height: 100px;" class="mb-2">
            <div class="form-text">Envie uma nova imagem para substituir.</div>
        <% } else { %>
            <span class="text-muted">Nenhuma imagem cadastrada.</span>
        <% } %>
        <input type="file" class="form-control mt-2" id="image" name="image" accept="image/*">
    </div>

    <button type="submit" class="btn btn-primary">Atualizar</button>
    <a href="/products" class="btn btn-secondary">Cancelar</a>
</form>

<%- include('../partials/footer') %>